# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# C extensions & build
*.o
*.obj
*.so
*.dylib
*.dll
build/
dist/
*.egg-info/

# Virtual environments
.venv/
.venv_bench/
env/
venv/
ENV/

